#!/bin/sh
# Starts Slipstream as a login session. The login screen runs this through slipstream.desktop in
# its wayland-sessions folder (see scripts/install-session).

# The log goes in the state folder; if that can't be written, somewhere it can, so a session that
# fails to start still says why. A fixed name in a shared /tmp could already be someone else's,
# so there it gets a fresh folder.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/slipstream"
if ! mkdir -p "$state_dir" 2>/dev/null || ! [ -w "$state_dir" ]; then
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
        state_dir="$XDG_RUNTIME_DIR/slipstream-$(id -u)"
        mkdir -p "$state_dir"
    else
        state_dir=$(mktemp -d /tmp/slipstream-session.XXXXXX)
    fi
fi
log="$state_dir/slipstream.log"
[ -f "$log" ] && mv -f "$log" "$log.old"

# Slipstream names only itself: it borrows no other desktop's settings, and apps that ask what
# they are running under get one answer. Which portal backend answers which interface is written
# in slipstream-portals.conf when Slipstream is installed, from what is on the machine.
export XDG_CURRENT_DESKTOP=Slipstream
export XDG_SESSION_DESKTOP=slipstream
export XDG_SESSION_TYPE=wayland
# Wayland everywhere it's optional.
export QT_QPA_PLATFORM=wayland
# Qt apps take their file dialogs, colours and fonts from the portal rather than from some other
# desktop's plugin, which is the one route that works the same on every system. Without this they
# fall back to Qt's own defaults, which is no worse than before.
if [ -z "${QT_QPA_PLATFORMTHEME:-}" ]; then
    for dir in /usr/lib64 /usr/lib /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu; do
        if [ -e "$dir/qt6/plugins/platformthemes/libqxdgdesktopportal.so" ] \
            || [ -e "$dir/qt5/plugins/platformthemes/libqxdgdesktopportal.so" ]; then
            export QT_QPA_PLATFORMTHEME=xdgdesktopportal
            break
        fi
    done
fi
# GTK apps that aren't in a sandbox read their colours and dialogs from their own machinery
# rather than from the portal unless this says otherwise, and Slipstream's dark and light setting
# only travels by portal. Sandboxed apps already ask it; there is nothing to gain, and a file
# dialog to lose, on a system with no portal installed at all.
if [ -z "${GTK_USE_PORTAL:-}" ]; then
    for dir in /usr/share /usr/local/share; do
        if [ -e "$dir/dbus-1/services/org.freedesktop.portal.Desktop.service" ]; then
            export GTK_USE_PORTAL=1
            break
        fi
    done
fi
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1
# The cursor theme this system calls its default, which every distribution sets for itself in
# icons/default/index.theme. Failing that, any installed theme that has cursors in it; failing
# that, whatever the toolkit falls back to.
icon_dirs="$HOME/.icons ${XDG_DATA_HOME:-$HOME/.local/share}/icons /usr/local/share/icons /usr/share/icons"
if [ -z "${XCURSOR_THEME:-}" ]; then
    for dir in $icon_dirs; do
        if [ -r "$dir/default/index.theme" ]; then
            XCURSOR_THEME=$(sed -n 's/^[[:space:]]*Inherits[[:space:]]*=[[:space:]]*//p' \
                "$dir/default/index.theme" | head -n1 | tr -d '\r' | cut -d, -f1)
            if [ -n "$XCURSOR_THEME" ]; then
                break
            fi
        fi
    done
fi
if [ -z "${XCURSOR_THEME:-}" ]; then
    for dir in $icon_dirs; do
        for cursors in "$dir"/*/cursors; do
            if [ -d "$cursors" ]; then
                theme=${cursors%/cursors}
                XCURSOR_THEME=${theme##*/}
                break
            fi
        done
        if [ -n "${XCURSOR_THEME:-}" ]; then
            break
        fi
    done
fi
export XCURSOR_THEME="${XCURSOR_THEME:-default}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# The keyboard layout set in System Settings or the installer, unless one is already chosen.
# localectl asks a D-Bus service, so it's given a few seconds at most rather than holding up login.
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ] && command -v localectl >/dev/null 2>&1; then
    if command -v timeout >/dev/null 2>&1; then
        status=$(timeout 5 localectl status 2>/dev/null || true)
    else
        status=$(localectl status 2>/dev/null || true)
    fi
    kb() { printf '%s\n' "$status" | sed -n "s/^ *X11 $1: //p"; }
    XKB_DEFAULT_LAYOUT=$(kb Layout)
    XKB_DEFAULT_MODEL=$(kb Model)
    XKB_DEFAULT_VARIANT=$(kb Variant)
    XKB_DEFAULT_OPTIONS=$(kb Options)
    export XKB_DEFAULT_LAYOUT XKB_DEFAULT_MODEL XKB_DEFAULT_VARIANT XKB_DEFAULT_OPTIONS
fi

unset DISPLAY WAYLAND_DISPLAY

# A copy in your own home wins, so a build of your own runs instead of the installed release for
# you alone; everyone else on the machine gets the one in /usr/local.
bin="$HOME/.local/bin/slipstream"
if [ ! -x "$bin" ]; then
    bin=/usr/local/bin/slipstream
fi

# Where the login screen logs straight back in after every logout (extras/omarchy-switch), a
# Slipstream that dies at startup would be started again and again. So a session that ends within
# a few seconds points the automatic login back at Omarchy first, and the next login lands there.
switch_helper=/usr/local/bin/slipstream-set-autologin
back_to_omarchy() {
    if [ -x "$switch_helper" ]; then
        echo "slipstream-session: switching the automatic login back to Omarchy." >>"$log"
        sudo -n "$switch_helper" omarchy >>"$log" 2>&1
    fi
}

if [ ! -x "$bin" ]; then
    echo "slipstream-session: no slipstream program in ~/.local/bin or /usr/local/bin." >"$log"
    echo "Install it with scripts/install-session, or build one with scripts/update-session." >>"$log"
    back_to_omarchy
    exit 0
fi
if [ ! -x "$switch_helper" ]; then
    exec "$bin" --session >"$log" 2>&1
fi
started=$(date +%s)
"$bin" --session >"$log" 2>&1
status=$?
if [ $(($(date +%s) - started)) -lt 15 ]; then
    echo "slipstream-session: Slipstream ended after under 15 seconds (status $status)." >>"$log"
    back_to_omarchy
fi
# SDDM reads the session's exit code as its helper's, and 1 there means "wrong password": it
# would neither log back in nor show a login screen. So a session that has ended reports success;
# the real status is in the log.
echo "slipstream-session: Slipstream exited with status $status." >>"$log"
exit 0
